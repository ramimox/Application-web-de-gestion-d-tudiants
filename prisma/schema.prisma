generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  age       Int
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}